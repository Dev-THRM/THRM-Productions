# Enable Rewrite Engine
Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

# 1. Redirect /index.html and /index to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(index|index\.html)?[\s\?] [NC]
RewriteRule ^(index|index\.html)$ / [R=301,L,NC]

# 2. Redirect requests with .html extension to clean URLs (e.g. /contact.html -> /contact)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.html[\s\?] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Clean section URLs -> serve index.html directly WITHOUT hash redirect (keeps clean /about, /work in address bar)
RewriteRule ^(about|about-us|work|our-work)/?$ index.html [L,NC]

# 4. Clean pages -> internally rewrite to .html file if it exists (e.g. /contact -> contact.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]
